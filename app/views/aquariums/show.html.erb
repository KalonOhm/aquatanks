<h1 class="text-center underline underline-offset-4 text-3xl font-medium mb-4"><%= @aquarium.user.name %>'s Aquarium</h1>

<%= render @aquarium%>


<%#= link_to "Show", aquarium_path(@aquarium)%>
<% if current_user == @aquarium.user %>
  <button  type="button" >
    <%= link_to "Edit", edit_aquarium_path(@aquarium), {:class => "text-xs inline-block rounded bg-teal-700 dark:bg-teal-500 px-3 pt-2 pb-1.5 mt-1.5 self-end  "} %>
  </button>
  <span type="button" >
    <%= button_to "Delete", @aquarium, method: :delete, class: "text-xs inline-block rounded bg-teal-700 dark:bg-teal-500 px-3 pt-2 pb-1.5 mt-1.5 self-end  " %>
  </span>
<%# Search-as-you-type: app/javascript/controllers/species_search_controller.js %>
<div class="mt-8 max-w-xl"
     data-controller="species-search"
     data-species-search-url-value="<%= search_species_path %>"
     data-species-search-water-value="<%= @aquarium.species_water %>"
     data-species-search-strict-value="<%= preferences.strict_add_search %>"
     data-action="click@window->species-search#close">
  <%= form_tag(add_species_aquarium_path(@aquarium), method: :post, class: "flex flex-wrap items-end gap-2") do %>
    <div class="relative flex-1 min-w-[16rem]">
      <%= label_tag :species_search, "Add a species", class: "block text-sm" %>
      <%= text_field_tag :species_search, nil,
            placeholder: "Search any name, e.g. neon tetra",
            autocomplete: "off",
            class: "w-full rounded text-slate-900",
            data: { species_search_target: "input", action: "input->species-search#search keydown->species-search#keydown" } %>
      <%= hidden_field_tag :species_id, nil, data: { species_search_target: "speciesId" } %>
      <div hidden
           class="absolute z-20 mt-1 w-full max-h-72 overflow-y-auto rounded bg-white text-slate-900 shadow-lg dark:bg-neutral-700 dark:text-cyan-100"
           data-species-search-target="results"></div>
    </div>
    <%= number_field_tag :count, 1, min: 1, class: "w-20 rounded text-slate-900", aria: { label: "How many" } %>
    <%= submit_tag 'Add to Tank', disabled: true,
          class: "text-xs inline-block rounded bg-teal-700 dark:bg-teal-500 px-3 pt-2 pb-1.5 mt-1.5 self-end disabled:opacity-50",
          data: { species_search_target: "submit" } %>
  <% end %>
</div>

<% end %>

<% @stock_by_category.each do |category, entries| %>
  <h2 class="text-xl font-medium mt-8 mb-2 ml-10"><%= SpeciesHelper::CATEGORY_HEADINGS[category] %></h2>
  <div class="grid lg:grid-cols-3 md:grid-cols-2 gap-y-4 ml-10">
    <%= render entries, aquarium: @aquarium %>
  </div>
<% end %>
