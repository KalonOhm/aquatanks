<!DOCTYPE html>
<%# Theme preference: Tailwind's dark: classes apply when <html> has class "dark" %>
<html class="sm:scroll-smooth <%= 'dark' if preferences.theme == 'dark' %>">
  <head>
    <title>Aquatanks</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="aquatanks-theme" content="<%= preferences.theme %>">
    <script>
      // Sets the "dark" class on <html> from the theme in the meta tag above.
      // Runs now (before the page paints) and again after every Turbo visit:
      // Turbo swaps the meta tag but keeps <html>, so logging in or saving a
      // new theme would otherwise leave the old one showing.
      if (!window.applyAquatanksTheme) {
        const darkMedia = matchMedia("(prefers-color-scheme: dark)")
        window.applyAquatanksTheme = () => {
          const theme = document.querySelector('meta[name="aquatanks-theme"]')?.content
          document.documentElement.classList.toggle("dark", theme === "dark" || (theme === "system" && darkMedia.matches))
        }
        darkMedia.addEventListener("change", window.applyAquatanksTheme)
        document.addEventListener("turbo:render", window.applyAquatanksTheme)
      }
      window.applyAquatanksTheme()
    </script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= favicon_link_tag asset_path('tropical-fish_1f420.png') %>
  </head>

  <body class="min-h-screen bg-cyan-100 dark:bg-cyan-900 dark:text-cyan-100" >
    <%= render "shared/nav" %>
    <div class="container mx-auto px-4 dark:text-cyan-100">
    <% flash.each do |type, message| %>
      <% if type == "alert" %>
        <p class="max-w-sm mx-auto my-4 rounded-lg bg-red-200 p-3 text-red-900 text-center shadow dark:bg-red-900 dark:text-red-100"><%= message %></p>
      <% else %>
        <p class="max-w-sm mx-auto my-4 rounded-lg bg-teal-200 p-3 text-navy-500 text-center shadow dark:bg-neutral-700"><%= message %></p>
      <% end %>
    <% end %>
    <%= yield %>
    </div>
    
  </body>
</html>
