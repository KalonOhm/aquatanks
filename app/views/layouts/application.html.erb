<!DOCTYPE html>
<html class="sm:scroll-smooth">
  <head>
    <title>Aquatanks</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= favicon_link_tag asset_path('tropical-fish_1f420.png') %>
  </head>

  <body class="min-h-screen bg-cyan-100 dark:bg-cyan-900 dark:text-cyan-100" >
    <%= render "shared/nav" %>
    <div class="container mx-auto px-4 dark:text-cyan-100">
    <% flash.each do |type, message| %>
      <p class="max-w-sm mx-auto my-4 rounded-lg bg-teal-200 p-3 text-navy-500 text-center shadow dark:bg-neutral-700"><%= message %></p>
    <% end %>
    <%= yield %>
    </div>
    
  </body>
</html>
