<%= form_with(model: species) do |form| %>
  <% if species.errors.any? %>
    <div class="text-orange-400">
      <h2><%= pluralize(species.errors.count, "error") %> prohibited this species from being saved:</h2>

      <ul>
        <% species.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
<div class="block max-w-sm mx-auto rounded-lg bg-white p-6 shadow-lg dark:bg-neutral-700" >
  <div class="dark:text-teal-900">
    <%= form.label :common_name, style: "display: block" %>
    <%= form.text_field :common_name %>
  </div>

  <div class="dark:text-teal-900">
    <%= form.label :alias_list, "Other common names (comma separated)", style: "display: block" %>
    <%= form.text_field :alias_list %>
  </div>

  <div class="dark:text-teal-900">
    <%= form.label :taxonomic_name, "Scientific name", style: "display: block" %>
    <%= form.text_field :taxonomic_name %>
  </div>

  <div class="dark:text-teal-900">
    <%= form.label :category, style: "display: block" %>
    <%= form.select :category, Species::CATEGORIES.map { |c| [c.capitalize, c] } %>
  </div>

  <div class="dark:text-teal-900">
    <%= form.label :preferred_water, style: "display: block" %>
    <%= form.select :preferred_water, Species::WATER_TYPES.map { |w| [w.humanize, w] }, include_blank: true %>
  </div>

  <div class="dark:text-teal-900">
    <%= form.label :image_url, style: "display: block" %>
    <%= form.text_field :image_url %>
  </div>

  <div class="dark:text-teal-900">
    <%= form.label :size, style: "display: block" %>
    <%= form.text_field :size %>
  </div>

  <div class="dark:text-teal-900">
    <%= form.label :other_remarks, style: "display: block" %>
    <%= form.text_field :other_remarks %>
  </div>

  <div>
    <%= form.submit %>
  </div>
</div>

<% end %>
