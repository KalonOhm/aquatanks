<h1 class="text-center underline underline-offset-4 text-3xl font-medium mb-4"><%=@user.name%>'s Aquariums</h1>

<% if current_user == @user %>
  <div class="text-center mb-4">
    <%= link_to "Add New Aquarium", new_aquarium_path, {:class => "inline-block rounded bg-teal-700 dark:bg-teal-500 px-3 pt-2 pb-1.5 mt-1.5 self-end  "} %>
  </div>
<% end %>

<% if @page.total_count.zero? %>
  <p class="text-center text-lg text-gray-500 dark:text-gray-400">
    <%=@user.name%> doesn't have any aquariums yet. <% if current_user == @user %>
      Click the button above to add one!
    <% end %>
  </p>
<% elsif @page.total_pages > 1 %>
  <%= render "shared/pagination", page: @page %>
<% end %>

<div id="aquariums" class="grid lg:grid-cols-3 md:grid-cols-2 gap-y-4 ml-10">
  <%= render partial: "aquariums/card", collection: @user_aquariums, as: :aquarium %>
</div>

<%= render "shared/pagination", page: @page if @page.total_pages > 1 %>
